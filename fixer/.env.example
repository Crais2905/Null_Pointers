# Insert your Google AI Studio key here. Never commit .env.
GEMINI_API_KEY=
LLM_MODEL=gemini-3.5-flash-lite
# auto = live with key, offline replay without key; 1 = force demo; 0 = force live.
REPLAY=auto
RECORD=0
LLM_TIMEOUT_SECONDS=20
AI_BASE_URL=http://127.0.0.1:8000
DISPATCH_WEBHOOK_URL=
VITE_API_URL=http://localhost:8080
VITE_USE_MOCKS=false
